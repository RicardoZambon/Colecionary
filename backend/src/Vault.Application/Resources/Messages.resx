  <!-- First-run setup wizard -->
  <data name="SetupFieldsRequired" xml:space="preserve">
    <value>Organization name, owner name and owner email are required.</value>
  </data>
  <data name="SetupPasswordTooShort" xml:space="preserve">
    <value>Password must be at least 8 characters.</value>
  </data>
  <data name="SetupDatabaseNotUsable" xml:space="preserve">
    <value>Database not usable: {0}.</value>
    <comment>{0} = DatabaseConnectionResult name</comment>
  </data>
</root>
