{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Vault": ""
  },
  "Jwt": {
    "Issuer": "vault-api",
    "Audience": "vault-app",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": "vault-demo"
  },
  "LoginThrottle": {
    "Enabled": true,
    "FailureWindow": "00:05:00",
    "MaxAccountFailures": 10,
    "AccountDelay": "00:05:00",
    "MaxAccountDelay": "00:30:00",
    "MaxClientFailures": 30,
    "ClientDelay": "00:05:00",
    "MaxConcurrentPerClient": 8,
    "RecordExpiry": "01:00:00",
    "MaxTrackedRecords": 20000
  },
  "ImageStorage": {
    "Root": "App_Data/images"
  },
  "ImageGc": {
    "Enabled": false,
    "DryRun": true,
    "GracePeriod": "30.00:00:00",
    "Interval": "06:00:00",
    "InitialDelay": "00:05:00",
    "BatchSize": 200,
    "CollectOrphanFiles": true
  },
  "Cors": {
    "Origins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
