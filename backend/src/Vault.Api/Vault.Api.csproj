<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Overwritten by the release workflow (semantic-release computed version). -->
    <Version>0.0.0</Version>
    <!-- Per-developer dev overrides (e.g. a non-local DB) live in user-secrets,
         read automatically in Development. Keeps env-specific hosts/passwords out of git. -->
    <UserSecretsId>7df75f9d-d12f-42bc-ad29-aa77405a9f72</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vault.Application\Vault.Application.csproj" />
    <ProjectReference Include="..\Vault.Infrastructure\Vault.Infrastructure.csproj" />
  </ItemGroup>

</Project>
