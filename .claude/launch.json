{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "ng",
        "serve",
        "--host",
        "0.0.0.0",
        "--port",
        "4200"
      ],
      "cwd": "frontend",
      "port": 4200
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Vault.Api"
      ],
      "cwd": "backend",
      "port": 5100
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "prototype"
      ],
      "port": 4173
    }
  ]
}